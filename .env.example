# MiMo Desktop 配置文件
# 复制此文件为 .env 并填入你的配置

# 飞书配置（可选，用于日历同步）
FEISHU_APP_ID=你的飞书AppID
FEISHU_APP_SECRET=你的飞书AppSecret

# Obsidian Vault 路径
OBSIDIAN_VAULT_PATH=D:\你的笔记库路径

# 天气：默认使用 Open-Meteo（完全免费、无需注册/密钥），无需配置
# 如需自定义汇率（API 价格模块跨币种比较用），可设置：
# USD_CNY_RATE=7.1

# Web 服务器端口（浏览器远程访问）
WEB_SERVER_PORT=3001

# AI 助手（OpenAI 兼容接口，如 DeepSeek / 通义 / 本地 Ollama）
# 注意：API Key 不要手填！请在 AI 助手的「设置」弹窗中填写保存，
# 程序会以 AES-256-GCM 加密后写入 AI_API_KEY_ENC（主密钥存于系统用户目录，不入库）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
