{
  "name": "yujie-workbench",
  "version": "1.0.0",
  "description": "宇界工作台 - 个人工作台",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:web": "concurrently -n api,web -c green,blue \"tsx watch src/server/index.ts\" \"vite --port 5173\"",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist/server --emptyOutDir false",
    "dev:electron": "node scripts/electron-fix.cjs && npm run build:electron && concurrently -n vite,api,app -c blue,green,magenta \"vite --port 5173\" \"tsx watch src/server/index.ts\" \"wait-on http://localhost:5173 http://localhost:3001 && electron . --remote-debugging-port=9222\"",
    "build": "node scripts/electron-fix.cjs && npm run build:electron && tsc -p tsconfig.json && vite build && npm run build:server",
    "start": "electron .",
    "preview": "vite preview",
    "server": "tsx src/server/index.ts",
    "dist": "npm run build && electron-builder --dir",
    "dist:nsis": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@arco-design/web-react": "^2.66.16",
    "@codemirror/lang-markdown": "^6.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tremor/react": "^3.18.7",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.6",
    "antd": "^5.15.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.46.0",
    "lunar-javascript": "^1.7.7",
    "mind-elixir": "5.15.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.4.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3",
    "glob": "^10.3.10",
    "node-cron": "^3.0.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "type": "module"
}
